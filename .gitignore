# Unity .gitignore for Git LFS projects

# =============================
# Folders to ignore
# =============================
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
UserSettings/

# MemoryCaptures can get too large
/[Mm]emoryCaptures/

# Recordings can get too large
/[Rr]ecordings/

# Addressables auto-generated files
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/StreamingAssets/aa*

# Visual Scripting auto-generated files
/[Aa]ssets/Unity.VisualScripting.Generated/**

# Auto-generated scenes by play mode tests
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Crashlytics, Mono, VS, Gradle, Rider
*.log
*.pidb
*.pdb
*.mdb
*.opendb
*.VC.db
mono_crash.*
.vs/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs

# =============================
# Files to include (force)
# =============================
# Always include meta files
!*.meta

# Force include Assets and ProjectSettings
!Assets/
!ProjectSettings/
!Packages/

# =============================
# Files to ignore (optional assets)
# =============================
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app
*.blend1
*.blend1.meta
crashlytics-build.properties
sysinfo.txt
InitTestScene*.unity*